; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=x86_64-- -mattr=+avx512bw,+avx512vl -verify-machineinstrs | FileCheck %s

;; bf16 splats are lowered as vXi16 shuffles, but combineTargetShuffle turns
;; VBROADCAST(bitcast(x)) into bitcast(VBROADCAST(x)) when x is a legal bf16
;; vector, e.g. a value that is live across basic blocks or a volatile load.
;; FIXME: Targets without AVX512BW+VLX crash on these, so they are not tested
;; yet.

define void @splat_v8bf16_cross_block(<8 x bfloat> %v, i1 %c, ptr %p) nounwind {
; CHECK-LABEL: splat_v8bf16_cross_block:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    testb $1, %dil
; CHECK-NEXT:    je .LBB0_2
; CHECK-NEXT:  # %bb.1: # %splat
; CHECK-NEXT:    vpbroadcastw %xmm0, %xmm0
; CHECK-NEXT:    vmovdqa %xmm0, (%rsi)
; CHECK-NEXT:  .LBB0_2: # %exit
; CHECK-NEXT:    retq
entry:
  br i1 %c, label %splat, label %exit
splat:
  %s = shufflevector <8 x bfloat> %v, <8 x bfloat> poison, <8 x i32> zeroinitializer
  store <8 x bfloat> %s, ptr %p
  br label %exit
exit:
  ret void
}

define void @splat_v16bf16_from_v8bf16_cross_block(<8 x bfloat> %v, i1 %c, ptr %p) nounwind {
; CHECK-LABEL: splat_v16bf16_from_v8bf16_cross_block:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    testb $1, %dil
; CHECK-NEXT:    je .LBB1_2
; CHECK-NEXT:  # %bb.1: # %splat
; CHECK-NEXT:    vpbroadcastw %xmm0, %ymm0
; CHECK-NEXT:    vmovdqa %ymm0, (%rsi)
; CHECK-NEXT:  .LBB1_2: # %exit
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    retq
entry:
  br i1 %c, label %splat, label %exit
splat:
  %s = shufflevector <8 x bfloat> %v, <8 x bfloat> poison, <16 x i32> zeroinitializer
  store <16 x bfloat> %s, ptr %p
  br label %exit
exit:
  ret void
}

