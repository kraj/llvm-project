;; A volatile load cannot be narrowed into a 16-bit broadcast load, so this
;; needs a register broadcast even within a single block.
define void @splat_v8bf16_volatile_load(ptr %src, ptr %dst) nounwind {
; CHECK-LABEL: splat_v8bf16_volatile_load:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vmovdqa (%rdi), %xmm0
; CHECK-NEXT:    vpbroadcastw %xmm0, %xmm0
; CHECK-NEXT:    vmovdqa %xmm0, (%rsi)
; CHECK-NEXT:    retq
  %v = load volatile <8 x bfloat>, ptr %src
  %s = shufflevector <8 x bfloat> %v, <8 x bfloat> poison, <8 x i32> zeroinitializer
  store <8 x bfloat> %s, ptr %dst
  ret void
}

;; A load whose other uses are simplified away after legalization is folded
;; into a bf16 VBROADCAST_LOAD.
define void @splat_v8bf16_broadcast_load(ptr %p, <8 x bfloat> %other, ptr %dst1, ptr %dst2) nounwind {
; CHECK-LABEL: splat_v8bf16_broadcast_load:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vpbroadcastw (%rdi), %xmm1
; CHECK-NEXT:    vmovdqa %xmm1, (%rsi)
; CHECK-NEXT:    vmovddup {{.*#+}} xmm0 = xmm0[0,0]
; CHECK-NEXT:    vmovaps %xmm0, (%rdx)
; CHECK-NEXT:    retq
  %ld = load <8 x bfloat>, ptr %p
  %shuf = shufflevector <8 x bfloat> %ld, <8 x bfloat> %other, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 8, i32 9, i32 10, i32 11>
  %splat0 = shufflevector <8 x bfloat> %shuf, <8 x bfloat> poison, <8 x i32> zeroinitializer
  store <8 x bfloat> %splat0, ptr %dst1
  %other_lo = shufflevector <8 x bfloat> %shuf, <8 x bfloat> poison, <8 x i32> <i32 4, i32 5, i32 6, i32 7, i32 4, i32 5, i32 6, i32 7>
  store <8 x bfloat> %other_lo, ptr %dst2
  ret void
}

define void @splat_v16bf16_broadcast_load(ptr %p, <8 x bfloat> %other, ptr %dst1, ptr %dst2) nounwind {
; CHECK-LABEL: splat_v16bf16_broadcast_load:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vpbroadcastw (%rdi), %ymm1
; CHECK-NEXT:    vmovdqa %ymm1, (%rsi)
; CHECK-NEXT:    vmovddup {{.*#+}} xmm0 = xmm0[0,0]
; CHECK-NEXT:    vmovaps %xmm0, (%rdx)
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    retq
  %ld = load <8 x bfloat>, ptr %p
  %shuf = shufflevector <8 x bfloat> %ld, <8 x bfloat> %other, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 8, i32 9, i32 10, i32 11>
  %splat0 = shufflevector <8 x bfloat> %shuf, <8 x bfloat> poison, <8 x i32> zeroinitializer
  %wide = shufflevector <8 x bfloat> poison, <8 x bfloat> %splat0, <16 x i32> <i32 poison, i32 poison, i32 poison, i32 poison, i32 poison, i32 poison, i32 poison, i32 poison, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
  store <16 x bfloat> %wide, ptr %dst1
  %other_lo = shufflevector <8 x bfloat> %shuf, <8 x bfloat> poison, <8 x i32> <i32 4, i32 5, i32 6, i32 7, i32 4, i32 5, i32 6, i32 7>
  store <8 x bfloat> %other_lo, ptr %dst2
  ret void
}

;; combineTargetShuffle must not look through a bitcast from v8bf16 to form a
;; broadcast of an illegal bf16 vector type (v16bf16 without AVX-NE-CONVERT or
;; AVX512BW).
define void @splat_v16i16_from_bitcast_v8bf16(<8 x bfloat> %v, i1 %c, ptr %dst) nounwind {
; CHECK-LABEL: splat_v16i16_from_bitcast_v8bf16:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    testb $1, %dil
; CHECK-NEXT:    je .LBB6_2
; CHECK-NEXT:  # %bb.1: # %splat
; CHECK-NEXT:    vpbroadcastw %xmm0, %ymm0
; CHECK-NEXT:    vmovdqa %ymm0, (%rsi)
; CHECK-NEXT:  .LBB6_2: # %exit
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    retq
entry:
  br i1 %c, label %splat, label %exit
splat:
  %bc = bitcast <8 x bfloat> %v to <8 x i16>
  %s = shufflevector <8 x i16> %bc, <8 x i16> poison, <16 x i32> zeroinitializer
  store <16 x i16> %s, ptr %dst
  br label %exit
exit:
  ret void
}

define void @rebroadcast_v8i32_from_v8bf16(ptr %src, ptr %dst1, ptr %dst2) nounwind {
; CHECK-LABEL: rebroadcast_v8i32_from_v8bf16:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vmovdqa (%rdi), %xmm0
; CHECK-NEXT:    vpbroadcastw %xmm0, %ymm0
; CHECK-NEXT:    vmovdqa %xmm0, (%rsi)
; CHECK-NEXT:    vmovdqa %ymm0, (%rdx)
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    retq
  %v = load volatile <8 x bfloat>, ptr %src
  %s8 = shufflevector <8 x bfloat> %v, <8 x bfloat> poison, <8 x i32> zeroinitializer
  store <8 x bfloat> %s8, ptr %dst1
  %bc = bitcast <8 x bfloat> %s8 to <4 x i32>
  %s256 = shufflevector <4 x i32> %bc, <4 x i32> poison, <8 x i32> zeroinitializer
  store <8 x i32> %s256, ptr %dst2
  ret void
}
