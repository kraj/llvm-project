# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -passes=early-machinelicm -stress-regalloc=9 -o - %s | FileCheck %s

--- |
  define void @multiple_hoists_raise_peak() {
    ret void
  }
  define void @negative_cost_hoist_lowers_peak() {
    ret void
  }
...

# Current pressure falls from 6 to 2 before the COPYs. The first two hoists
# increase the saved peak to 7 and 8. The third would reach the limit of 9.
# Both accepted hoists must be charged once even while current pressure is low.
---
name: multiple_hoists_raise_peak
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: multiple_hoists_raise_peak
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0, $sgpr1, $sgpr2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sgpr_32 = COPY $sgpr0
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:sgpr_32 = COPY $sgpr1
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:sgpr_32 = COPY $sgpr2
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:vgpr_32 = COPY [[COPY1]]
  ; CHECK-NEXT:   [[COPY5:%[0-9]+]]:vgpr_32 = COPY [[COPY2]]
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:vgpr_32 = PHI [[COPY]], %bb.0, %5, %bb.1
  ; CHECK-NEXT:   [[DS_READ_B128_gfx9_:%[0-9]+]]:vreg_128 = DS_READ_B128_gfx9 [[PHI]], 0, 0, implicit $exec :: (load (s128), addrspace 3)
  ; CHECK-NEXT:   DS_WRITE_B128_gfx9 [[PHI]], [[DS_READ_B128_gfx9_]], 16, 0, implicit $exec :: (store (s128), addrspace 3)
  ; CHECK-NEXT:   [[COPY6:%[0-9]+]]:vgpr_32 = COPY [[COPY3]]
  ; CHECK-NEXT:   [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[PHI]], [[COPY4]], implicit $exec
  ; CHECK-NEXT:   [[V_ADD_U32_e32_1:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[V_ADD_U32_e32_]], [[COPY5]], implicit $exec
  ; CHECK-NEXT:   [[V_ADD_U32_e32_2:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[V_ADD_U32_e32_1]], [[COPY6]], implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.1
  bb.0:
    liveins: $vgpr0, $sgpr0, $sgpr1, $sgpr2

    %0:vgpr_32 = COPY $vgpr0
    %1:sgpr_32 = COPY $sgpr0
    %2:sgpr_32 = COPY $sgpr1
    %3:sgpr_32 = COPY $sgpr2
    S_BRANCH %bb.1

  bb.1:
    %4:vgpr_32 = PHI %0, %bb.0, %11, %bb.1
    %5:vreg_128 = DS_READ_B128_gfx9 %4, 0, 0, implicit $exec :: (load (s128), addrspace 3)
    DS_WRITE_B128_gfx9 %4, %5, 16, 0, implicit $exec :: (store (s128), addrspace 3)
    %6:vgpr_32 = COPY %1
    %7:vgpr_32 = COPY %2
    %8:vgpr_32 = COPY %3
    %9:vgpr_32 = V_ADD_U32_e32 %4, %6, implicit $exec
    %10:vgpr_32 = V_ADD_U32_e32 %9, %7, implicit $exec
    %11:vgpr_32 = V_ADD_U32_e32 %10, %8, implicit $exec
    S_BRANCH %bb.1
...

# The one-use vreg_128 input costs 4 even though the COPY selects one subregister.
# Hoisting that COPY has net VGPR cost -3, lowering the peak from 10 to 7.
# The following +1 COPY can then move below the limit of 9.
---
name: negative_cost_hoist_lowers_peak
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: negative_cost_hoist_lowers_peak
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vreg_128 = COPY $vgpr0_vgpr1_vgpr2_vgpr3
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr4
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:sgpr_32 = COPY $sgpr0
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:vgpr_32 = COPY [[COPY]].sub0
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:vgpr_32 = COPY [[COPY2]]
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:vgpr_32 = PHI [[COPY1]], %bb.0, %4, %bb.1
  ; CHECK-NEXT:   [[DS_READ_B128_gfx9_:%[0-9]+]]:vreg_128 = DS_READ_B128_gfx9 [[PHI]], 0, 0, implicit $exec :: (load (s128), addrspace 3)
  ; CHECK-NEXT:   DS_WRITE_B128_gfx9 [[PHI]], [[DS_READ_B128_gfx9_]], 16, 0, implicit $exec :: (store (s128), addrspace 3)
  ; CHECK-NEXT:   [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[PHI]], [[COPY3]], implicit $exec
  ; CHECK-NEXT:   [[V_ADD_U32_e32_1:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[V_ADD_U32_e32_]], [[COPY4]], implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.1
  bb.0:
    liveins: $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4, $sgpr0

    %0:vreg_128 = COPY $vgpr0_vgpr1_vgpr2_vgpr3
    %1:vgpr_32 = COPY $vgpr4
    %2:sgpr_32 = COPY $sgpr0
    S_BRANCH %bb.1

  bb.1:
    %3:vgpr_32 = PHI %1, %bb.0, %8, %bb.1
    %4:vreg_128 = DS_READ_B128_gfx9 %3, 0, 0, implicit $exec :: (load (s128), addrspace 3)
    DS_WRITE_B128_gfx9 %3, %4, 16, 0, implicit $exec :: (store (s128), addrspace 3)
    %5:vgpr_32 = COPY %0.sub0
    %6:vgpr_32 = COPY %2
    %7:vgpr_32 = V_ADD_U32_e32 %3, %5, implicit $exec
    %8:vgpr_32 = V_ADD_U32_e32 %7, %6, implicit $exec
    S_BRANCH %bb.1
...
