# Mask larger than the modulo mask but still covering the low bits (0xff & 31 == 31).
---
name: shl_and_superset_mask
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: shl_and_superset_mask
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:vgpr(s32) = G_SHL [[COPY]], [[COPY1]](s32)
    ; CHECK-NEXT: $vgpr0 = COPY [[SHL]](s32)
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0
    %0:vgpr(s32) = COPY $vgpr0
    %1:vgpr(s32) = COPY $vgpr1
    %2:vgpr(s32) = G_CONSTANT i32 255
    %3:vgpr(s32) = G_AND %1, %2
    %4:vgpr(s32) = G_SHL %0, %3
    $vgpr0 = COPY %4
    S_ENDPGM 0, implicit $vgpr0
...

# The masked amount comes from an sgpr; the shift stays in vgpr.
---
name: shl_and_31_sgpr_amt
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $sgpr0
    ; CHECK-LABEL: name: shl_and_31_sgpr_amt
    ; CHECK: liveins: $vgpr0, $sgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:sgpr(s32) = COPY $sgpr0
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:vgpr(s32) = G_SHL [[COPY]], [[COPY1]](s32)
    ; CHECK-NEXT: $vgpr0 = COPY [[SHL]](s32)
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0
    %0:vgpr(s32) = COPY $vgpr0
    %1:sgpr(s32) = COPY $sgpr0
    %2:sgpr(s32) = G_CONSTANT i32 31
    %3:sgpr(s32) = G_AND %1, %2
    %4:vgpr(s32) = G_SHL %0, %3
    $vgpr0 = COPY %4
    S_ENDPGM 0, implicit $vgpr0
...

# i64 shift: mask 63 covers the modulo bits.
---
name: shl_i64_and_63
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2
    ; CHECK-LABEL: name: shl_i64_and_63
    ; CHECK: liveins: $vgpr0_vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr(s64) = COPY $vgpr0_vgpr1
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr(s32) = COPY $vgpr2
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:vgpr(s64) = G_SHL [[COPY]], [[COPY1]](s32)
    ; CHECK-NEXT: $vgpr0_vgpr1 = COPY [[SHL]](s64)
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0_vgpr1
    %0:vgpr(s64) = COPY $vgpr0_vgpr1
    %1:vgpr(s32) = COPY $vgpr2
    %2:vgpr(s32) = G_CONSTANT i32 63
    %3:vgpr(s32) = G_AND %1, %2
    %4:vgpr(s64) = G_SHL %0, %3
    $vgpr0_vgpr1 = COPY %4
    S_ENDPGM 0, implicit $vgpr0_vgpr1
...

# Negative: mask does not cover all low bits (30 misses bit 0).
---
name: shl_and_30_negative
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: shl_and_30_negative
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[C:%[0-9]+]]:vgpr(s32) = G_CONSTANT i32 30
    ; CHECK-NEXT: [[AND:%[0-9]+]]:vgpr(s32) = G_AND [[COPY1]], [[C]]
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:vgpr(s32) = G_SHL [[COPY]], [[AND]](s32)
    ; CHECK-NEXT: $vgpr0 = COPY [[SHL]](s32)
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0
    %0:vgpr(s32) = COPY $vgpr0
    %1:vgpr(s32) = COPY $vgpr1
    %2:vgpr(s32) = G_CONSTANT i32 30
    %3:vgpr(s32) = G_AND %1, %2
    %4:vgpr(s32) = G_SHL %0, %3
    $vgpr0 = COPY %4
    S_ENDPGM 0, implicit $vgpr0
...

# Negative: mask 15 is too small for an i64 shift (needs 63).
---
name: shl_i64_and_15_negative
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2
    ; CHECK-LABEL: name: shl_i64_and_15_negative
    ; CHECK: liveins: $vgpr0_vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr(s64) = COPY $vgpr0_vgpr1
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr(s32) = COPY $vgpr2
    ; CHECK-NEXT: [[C:%[0-9]+]]:vgpr(s32) = G_CONSTANT i32 15
    ; CHECK-NEXT: [[AND:%[0-9]+]]:vgpr(s32) = G_AND [[COPY1]], [[C]]
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:vgpr(s64) = G_SHL [[COPY]], [[AND]](s32)
    ; CHECK-NEXT: $vgpr0_vgpr1 = COPY [[SHL]](s64)
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0_vgpr1
    %0:vgpr(s64) = COPY $vgpr0_vgpr1
    %1:vgpr(s32) = COPY $vgpr2
    %2:vgpr(s32) = G_CONSTANT i32 15
    %3:vgpr(s32) = G_AND %1, %2
    %4:vgpr(s64) = G_SHL %0, %3
    $vgpr0_vgpr1 = COPY %4
    S_ENDPGM 0, implicit $vgpr0_vgpr1
...

