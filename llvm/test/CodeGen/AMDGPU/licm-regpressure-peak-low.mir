# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -passes=early-machinelicm -stress-regalloc=8 -o - %s | FileCheck %s

--- |
  define void @low_pressure_peak() {
    ret void
  }
  define void @ancestor_hoist_updates_peak() {
    ret void
  }
...

# The same COPY can move when the peak plus its cost stays below the limit.
---
name: low_pressure_peak
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: low_pressure_peak
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sgpr_32 = COPY $sgpr0
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:vgpr_32 = COPY [[COPY1]]
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:vgpr_32 = PHI [[COPY]], %bb.0, %3, %bb.1
  ; CHECK-NEXT:   [[DS_READ_B128_gfx9_:%[0-9]+]]:vreg_128 = DS_READ_B128_gfx9 [[PHI]], 0, 0, implicit $exec :: (load (s128), addrspace 3)
  ; CHECK-NEXT:   DS_WRITE_B128_gfx9 [[PHI]], [[DS_READ_B128_gfx9_]], 16, 0, implicit $exec :: (store (s128), addrspace 3)
  ; CHECK-NEXT:   [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[PHI]], [[COPY2]], implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.1
  bb.0:
    liveins: $vgpr0, $sgpr0

    %0:vgpr_32 = COPY $vgpr0
    %1:sgpr_32 = COPY $sgpr0
    S_BRANCH %bb.1

  bb.1:
    %2:vgpr_32 = PHI %0, %bb.0, %5, %bb.1
    %3:vreg_128 = DS_READ_B128_gfx9 %2, 0, 0, implicit $exec :: (load (s128), addrspace 3)
    DS_WRITE_B128_gfx9 %2, %3, 16, 0, implicit $exec :: (store (s128), addrspace 3)
    %4:vgpr_32 = COPY %1
    %5:vgpr_32 = V_ADD_U32_e32 %2, %4, implicit $exec
    S_BRANCH %bb.1
...

# The first child's COPY can move, raising the ancestor's peak from 6 to 7.
# The later COPY must stay: its cost would bring the ancestor to the limit of 8.
---
name: ancestor_hoist_updates_peak
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: ancestor_hoist_updates_peak
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0, $sgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sgpr_32 = COPY $sgpr0
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:sgpr_32 = COPY $sgpr1
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:vgpr_32 = COPY [[COPY1]]
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:vgpr_32 = PHI [[COPY]], %bb.0, %4, %bb.3
  ; CHECK-NEXT:   [[DS_READ_B128_gfx9_:%[0-9]+]]:vreg_128 = DS_READ_B128_gfx9 [[PHI]], 0, 0, implicit $exec :: (load (s128), addrspace 3)
  ; CHECK-NEXT:   DS_WRITE_B128_gfx9 [[PHI]], [[DS_READ_B128_gfx9_]], 16, 0, implicit $exec :: (store (s128), addrspace 3)
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[PHI]], [[COPY3]], implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:vgpr_32 = COPY [[COPY2]]
  ; CHECK-NEXT:   [[V_ADD_U32_e32_1:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[V_ADD_U32_e32_]], [[COPY4]], implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.1
  bb.0:
    liveins: $vgpr0, $sgpr0, $sgpr1

    %0:vgpr_32 = COPY $vgpr0
    %1:sgpr_32 = COPY $sgpr0
    %2:sgpr_32 = COPY $sgpr1
    S_BRANCH %bb.1

  bb.1:
    %3:vgpr_32 = PHI %0, %bb.0, %8, %bb.3
    %4:vreg_128 = DS_READ_B128_gfx9 %3, 0, 0, implicit $exec :: (load (s128), addrspace 3)
    DS_WRITE_B128_gfx9 %3, %4, 16, 0, implicit $exec :: (store (s128), addrspace 3)
    S_BRANCH %bb.2

  bb.2:
    %5:vgpr_32 = COPY %1
    %6:vgpr_32 = V_ADD_U32_e32 %3, %5, implicit $exec
    S_BRANCH %bb.3

  bb.3:
    %7:vgpr_32 = COPY %2
    %8:vgpr_32 = V_ADD_U32_e32 %6, %7, implicit $exec
    S_BRANCH %bb.1
...
