; CHECK-NEXT:        Against group GRP1:
; CHECK-NEXT:          %q = getelementptr inbounds i64, ptr %p, i64 %i
; CHECK-NEXT:      Grouped accesses:
; CHECK-NEXT:        Group GRP0:
; CHECK-NEXT:          (Low: (8 + %s) High: (16 + %s))
; CHECK-NEXT:            Member: (12 + %s)
; CHECK-NEXT:            Member: (8 + %s)
