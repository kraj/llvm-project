; A loop from the following source code:
;   for (int i = start; i < 10000; i++) a[i] = a[i - 32] + 1;
; FIXME: i - 32 should be widened to "add nsw i64 %indvars.iv, -32".
define void @runtime_start(ptr %a, i32 %start, ptr %len.p) {
; CHECK-LABEL: define void @runtime_start(
; CHECK-SAME: ptr [[A:%.*]], i32 [[START:%.*]], ptr [[LEN_P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[LEN:%.*]] = load i32, ptr [[LEN_P]], align 4, !range [[RNG0]]
; CHECK-NEXT:    [[LEN_OK:%.*]] = icmp ugt i32 [[LEN]], 9999
; CHECK-NEXT:    [[START_OK:%.*]] = icmp ult i32 [[START]], [[LEN]]
; CHECK-NEXT:    [[START_M32:%.*]] = add i32 [[START]], -32
; CHECK-NEXT:    [[START_M32_OK:%.*]] = icmp ult i32 [[START_M32]], [[LEN]]
; CHECK-NEXT:    [[C0:%.*]] = and i1 [[LEN_OK]], [[START_OK]]
; CHECK-NEXT:    [[C1:%.*]] = and i1 [[C0]], [[START_M32_OK]]
; CHECK-NEXT:    [[START_LT:%.*]] = icmp slt i32 [[START]], 10000
; CHECK-NEXT:    [[C:%.*]] = and i1 [[C1]], [[START_LT]]
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP_PREHEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    [[TMP0:%.*]] = zext i32 [[START]] to i64
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[INDVARS_IV:%.*]] = phi i64 [ [[TMP0]], %[[LOOP_PREHEADER]] ], [ [[INDVARS_IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[TMP1:%.*]] = trunc nuw i64 [[INDVARS_IV]] to i32
; CHECK-NEXT:    [[IDX:%.*]] = add nsw i32 [[TMP1]], -32
; CHECK-NEXT:    [[IDX_EXT:%.*]] = zext nneg i32 [[IDX]] to i64
; CHECK-NEXT:    [[SRC:%.*]] = getelementptr inbounds nuw i8, ptr [[A]], i64 [[IDX_EXT]]
; CHECK-NEXT:    [[V:%.*]] = load i8, ptr [[SRC]], align 1
; CHECK-NEXT:    [[V1:%.*]] = add i8 [[V]], 1
; CHECK-NEXT:    [[DST:%.*]] = getelementptr inbounds nuw i8, ptr [[A]], i64 [[INDVARS_IV]]
; CHECK-NEXT:    store i8 [[V1]], ptr [[DST]], align 1
; CHECK-NEXT:    [[INDVARS_IV_NEXT]] = add nuw nsw i64 [[INDVARS_IV]], 1
; CHECK-NEXT:    [[TMP2:%.*]] = trunc nuw i64 [[INDVARS_IV]] to i32
; CHECK-NEXT:    [[DONE:%.*]] = icmp sgt i32 [[TMP2]], 9998
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT_LOOPEXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %len = load i32, ptr %len.p, align 4, !range !0
  %len.ok = icmp ugt i32 %len, 9999
  %start.ok = icmp ult i32 %start, %len
  %start.m32 = add i32 %start, -32
  %start.m32.ok = icmp ult i32 %start.m32, %len
  %c0 = and i1 %len.ok, %start.ok
  %c1 = and i1 %c0, %start.m32.ok
  %start.lt = icmp slt i32 %start, 10000
  %c = and i1 %c1, %start.lt
  br i1 %c, label %loop, label %exit
loop:
  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop ]
  %idx = add nsw i32 %iv, -32
  %idx.ext = zext nneg i32 %idx to i64
  %src = getelementptr inbounds nuw i8, ptr %a, i64 %idx.ext
  %v = load i8, ptr %src, align 1
  %v1 = add i8 %v, 1
  %iv.ext = zext nneg i32 %iv to i64
  %dst = getelementptr inbounds nuw i8, ptr %a, i64 %iv.ext
  store i8 %v1, ptr %dst, align 1
  %iv.next = add nuw nsw i32 %iv, 1
  %done = icmp sgt i32 %iv, 9998
  br i1 %done, label %exit, label %loop
exit:
  ret void
}

