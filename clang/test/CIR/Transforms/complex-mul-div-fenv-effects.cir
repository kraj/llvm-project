// RUN: cir-opt %s -canonicalize -o - | FileCheck %s

// Without a `fenv` attribute, complex FP multiplication and division have no
// memory effects, so unused results are erased. A `fenv` attribute gives them
// read and write effects on the floating-point environment, which keeps them
// alive.

!complex_f32 = !cir.complex<!cir.float>

// CHECK-LABEL: @dead_unconstrained_is_removed
// CHECK-NOT:     cir.complex.fmul
// CHECK-NOT:     cir.complex.fdiv
// CHECK:         cir.return
cir.func @dead_unconstrained_is_removed(%a: !complex_f32, %b: !complex_f32) {
  %0 = cir.complex.fmul %a, %b range(full) : !complex_f32
  %1 = cir.complex.fdiv %a, %b range(full) : !complex_f32
  cir.return
}

// CHECK-LABEL: @dead_constrained_is_not_removed
// CHECK:         cir.complex.fmul %{{.*}}, %{{.*}} range(full) : !cir.complex<!cir.float> fenv<{{.*}}strict_except = true>
// CHECK:         cir.complex.fdiv %{{.*}}, %{{.*}} range(full) : !cir.complex<!cir.float> fenv<{{.*}}strict_except = true>
cir.func @dead_constrained_is_not_removed(%a: !complex_f32, %b: !complex_f32) {
  %0 = cir.complex.fmul %a, %b range(full) : !complex_f32 fenv<dynamic_rounding_mode = unknown, except_mode = unknown, strict_except = true>
  %1 = cir.complex.fdiv %a, %b range(full) : !complex_f32 fenv<dynamic_rounding_mode = unknown, except_mode = unknown, strict_except = true>
  cir.return
}
